{
  "name": "@matchbox-ai/core",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Tiny platform-neutral capability contract, verified execution, durable strike reporting and reconciliation",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit false --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test && npm run verify:package",
    "prepack": "npm run check",
    "prepare": "npm run build",
    "verify:package": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "MATCH_SPEC_V02.md"
  ]
}
